---
/**
 * Static game catalog homepage with client-side category and publisher filters.
 */
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const db = getDatabase();
const games = await getAllGames(db);
const publishers = await getAllPublishers(db);
const categories = [...new Map(
  games
    .filter((game) => game.category !== null)
    .map((game) => [game.category!.id, game.category!]),
).values()].sort((a, b) => a.name.localeCompare(b.name));
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <form
            class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-6"
            data-testid="game-filters"
            aria-labelledby="filter-heading"
          >
            <h3 id="filter-heading" class="mb-4 text-lg font-medium text-slate-100">Filter games</h3>
            <div class="grid gap-6 md:grid-cols-2">
              <fieldset>
                <legend class="mb-3 text-sm font-medium text-slate-200">Categories</legend>
                <div class="grid gap-2 sm:grid-cols-2">
                  {categories.map((category) => (
                    <label class="flex items-center gap-2 text-sm text-slate-300">
                      <input
                        type="checkbox"
                        name="category"
                        value={category.id}
                        data-testid={`category-filter-${category.id}`}
                        class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500"
                      />
                      <span>{category.name}</span>
                    </label>
                  ))}
                </div>
              </fieldset>

              <div>
                <label for="publisher-filter" class="mb-3 block text-sm font-medium text-slate-200">Publisher</label>
                <select
                  id="publisher-filter"
                  data-testid="publisher-filter"
                  class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                >
                  <option value="">All publishers</option>
                  {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
                </select>
              </div>
            </div>
            <button
              type="reset"
              data-testid="clear-filters"
              class="mt-6 rounded-lg border border-slate-600 px-4 py-2 text-sm text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            >
              Clear filters
            </button>
          </form>

          <p class="mb-4 text-sm text-slate-400" data-testid="filter-summary" aria-live="polite">
            Showing {games.length} {games.length === 1 ? 'game' : 'games'}
          </p>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>

          <div class="hidden" data-testid="no-filter-results">
            <EmptyState text="No games match these filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const gameCards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const gamesGrid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
  const noResults = document.querySelector<HTMLElement>('[data-testid="no-filter-results"]');
  const summary = document.querySelector<HTMLElement>('[data-testid="filter-summary"]');

  if (filterForm && gamesGrid && noResults && summary) {
    const updateResults = (): void => {
      const selectedCategories = new Set(
        Array.from(filterForm.querySelectorAll<HTMLInputElement>('input[name="category"]:checked'))
          .map((input) => input.value),
      );
      const publisherId = filterForm.querySelector<HTMLSelectElement>('#publisher-filter')?.value ?? '';
      let visibleCount = 0;

      for (const card of gameCards) {
        const categoryId = card.dataset.categoryId ?? '';
        const cardPublisherId = card.dataset.publisherId ?? '';
        const matchesCategory =
          selectedCategories.size === 0 || selectedCategories.has(categoryId);
        const matchesPublisher = publisherId === '' || cardPublisherId === publisherId;
        const visible = matchesCategory && matchesPublisher;
        card.classList.toggle('hidden', !visible);
        visibleCount += visible ? 1 : 0;
      }

      gamesGrid.classList.toggle('hidden', visibleCount === 0);
      noResults.classList.toggle('hidden', visibleCount !== 0);
      summary.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? 'game' : 'games'}`;
    };

    filterForm.addEventListener('change', updateResults);
    filterForm.addEventListener('reset', () => requestAnimationFrame(updateResults));
  }
</script>
